# Режим разработки
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0-dev

# API настройки (используем моки в разработке)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_MODE=MOCK

# Отладочные флаги
VITE_DEBUG=true
VITE_LOG_LEVEL=debug

# Дополнительные настройки
VITE_APP_NAME="AI Content Generator (Development)"
VITE_APP_DESCRIPTION="Разработка фронтенда генератора контента"