# Режим продакшн
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# API настройки (реальный бэкенд)
VITE_API_BASE_URL=https://api.your-domain.com/v1
VITE_API_MODE=REAL

# Оптимизации для продакшн
VITE_DEBUG=false
VITE_LOG_LEVEL=error

# Дополнительные настройки
VITE_APP_NAME="AI Content Generator"
VITE_APP_DESCRIPTION="Генератор контента с использованием Google Gemini API"

# Безопасность
VITE_ENABLE_ANALYTICS=true
VITE_SENTRY_DSN= # добавьте позже если нужно

# Оптимизации производительности
VITE_ENABLE_PREFETCH=true
VITE_ENABLE_COMPRESSION=true